{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/telecharger/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ia/:p1/:p2",
      "destination": "/api/ia?p=:p1&p=:p2"
    },
    {
      "source": "/api/ia/:p1",
      "destination": "/api/ia?p=:p1"
    }
  ]
}
