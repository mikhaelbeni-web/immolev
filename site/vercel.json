{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/telecharger/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ia/:chemin+",
      "destination": "/api/ia?c=:chemin+"
    }
  ]
}
